#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────

run_wizard() {

TOTAL_STAGES=7
REPO=leon-marzahn/sankaku-app
# Only non-secret values (domain, App name and ID, Coolify URL), so a re-run offers them again. Secrets are never saved.
ENV_FILE="$(cd "$(dirname "$0")/.." && pwd)/merge-queue/.env.wizard"

# clip VALUE puts VALUE on the clipboard without printing it.
clip() {
  if   command -v pbcopy   >/dev/null 2>&1; then printf '%s' "$1" | pbcopy
  elif command -v wl-copy  >/dev/null 2>&1; then printf '%s' "$1" | wl-copy
  elif command -v xclip    >/dev/null 2>&1; then printf '%s' "$1" | xclip -selection clipboard
  elif command -v clip.exe >/dev/null 2>&1; then printf '%s' "$1" | clip.exe
  else warn "no clipboard tool (pbcopy, wl-copy, xclip, clip.exe) found"; exit 1; fi
}

# paste_var NAME VALUE copies VALUE and waits until the human has added NAME in Coolify.
paste_var() {
  clip "$2"
  step "Add $BOLD$1$RESET and paste the value (it's on your clipboard)${3:+. $3}"
  pause "Added?"
}

banner "Merge queue: gitea-mq on Coolify, as a GitHub App on $REPO"

# on_main PATH: PATH exists on main.
on_main() { gh api "repos/$REPO/contents/$1?ref=main" >/dev/null 2>&1; }

stage "Before you start"
say "This sets up the merge queue described in merge-queue/README.md."
gh auth status >/dev/null 2>&1 || { warn "gh isn't signed in: run gh auth login, then re-run"; exit 1; }
for tool in openssl curl; do
  command -v "$tool" >/dev/null 2>&1 || { warn "$tool is missing: install it, then re-run"; exit 1; }
done
step "Its domain is the one in merge-queue/docker-compose.yml's labels; its DNS points at the Coolify server."
ask MQ_DOMAIN "The domain (no https://):"
MQ_DOMAIN="${MQ_DOMAIN#https://}"; MQ_DOMAIN="${MQ_DOMAIN%/}"
write_env MQ_DOMAIN "$MQ_DOMAIN"
MQ_URL="https://$MQ_DOMAIN"
# The routers that hide the dashboard name the domain in the compose file: Coolify escapes $ in labels.
COMPOSE="$(cd "$(dirname "$0")/.." && pwd)/merge-queue/docker-compose.yml"
if ! grep -qF "Host(\`$MQ_DOMAIN\`)" "$COMPOSE"; then
  warn "merge-queue/docker-compose.yml's labels name another domain: change both Host(…) rules to $MQ_DOMAIN in a PR"
  warn "first, or the dashboard is public."
  exit 1
fi

stage "Create the GitHub App"
if [[ -n "$(_existing APP_ID || true)" ]] && confirm "The App exists already (ID $(_existing APP_ID)). Skip this stage?"; then
  APP_SLUG=$(_existing APP_SLUG); APP_ID=$(_existing APP_ID)
else
open_url "https://github.com/settings/apps/new"
step "GitHub App name: tessera-merge-queue. auto-merge.yml recognises its comments by that name: another name"
note "  needs changing there too."
step "Homepage URL: https://github.com/$REPO"
step "Webhook: leave 'Active' ticked. URL: $MQ_URL/webhook/github. Leave the secret empty:"
note "  gitea-mq writes its own secret into the App when it starts."
step "Repository permissions:"
note "  Checks: Read and write · Commit statuses: Read-only · Contents: Read and write"
note "  Pull requests: Read and write · Administration: Read-only (not write: see the README)"
step "Subscribe to events: Check run, Pull request, Status."
note "  Each event appears only once its permission is set: Pull request needs Pull requests: Read and write."
step "Where can this GitHub App be installed: Only on this account. Click 'Create GitHub App'."
ask APP_SLUG "The App's name as in its page URL (github.com/settings/apps/<name>):"
write_env APP_SLUG "$APP_SLUG"
step "On that page, under 'About', copy the App ID (a number)."
ask APP_ID "Paste the App ID:"
write_env APP_ID "$APP_ID"
fi
[[ "$APP_ID" =~ ^[0-9]+$ ]] || { warn "an App ID is a number"; exit 1; }

stage "Coolify resource"
say "Like the runners' resources (runner/README.md), on any server with a little room: it's small."
PEM_PATH=""
if confirm "Is the Coolify resource deployed already? (y skips to the check)"; then
  note "Skipping: a new database password wouldn't match the database it made."
else
  open_url "https://github.com/settings/apps/$APP_SLUG"
  step "Scroll to 'Private keys' → 'Generate a private key'. A .pem file downloads."
  ask PEM_PATH "Path to the downloaded .pem (drag it into this window):"
  PEM_PATH="${PEM_PATH%\'}"; PEM_PATH="${PEM_PATH#\'}"; PEM_PATH="${PEM_PATH//\\ / }"
  [[ -f "$PEM_PATH" ]] || { warn "no file at $PEM_PATH"; exit 1; }
  grep -q "BEGIN RSA PRIVATE KEY" "$PEM_PATH" || { warn "$PEM_PATH isn't a GitHub App private key"; exit 1; }
  ask COOLIFY_URL "Your Coolify dashboard's URL:"
  write_env COOLIFY_URL "$COOLIFY_URL"
  open_url "$COOLIFY_URL"
  if on_main merge-queue/docker-compose.yml; then branch=main
  else branch=feat/merge-queue-401; note "merge-queue/ isn't on main yet: deploy from $branch, and switch to main once #402 merges."; fi
  step "Project → + New → Private Repository (with GitHub App) → this repo, branch $branch."
  step "Build pack: Docker Compose. Base directory: /merge-queue. Compose file: /docker-compose.yml. Continue."
  step "Under the gitea-mq service's Domains, enter: https://$MQ_DOMAIN:8080"
  note "  The :8080 is the container's port. The compose file's labels keep everything but the webhook and /healthz"
  note "  away from it: the dashboard has no login."
  step "Open Environment Variables. For each value below, the wizard puts it on your clipboard:"
  paste_var GITEA_MQ_EXTERNAL_URL "$MQ_URL"
  paste_var GITEA_MQ_GITHUB_APP_ID "$APP_ID"
  paste_var GITEA_MQ_GITHUB_PRIVATE_KEY_BASE64 "$(base64 < "$PEM_PATH" | tr -d '\n')"
  paste_var GITEA_MQ_GITHUB_WEBHOOK_SECRET "$(openssl rand -hex 32)"
  paste_var GITEA_MQ_DB_PASSWORD "$(openssl rand -hex 32)"
  clip ""
  printf '  %s✓ clipboard cleared%s\n' "$GREEN" "$RESET"
  step "Under Advanced (or Git → Watch paths), limit auto-deploy to: /merge-queue/**"
  step "Deploy, and wait until both services (gitea-mq and db) are running."
  pause "Deployed?"
fi

stage "Check"
say "Asking $MQ_URL/healthz:"
if curl -fsS --max-time 10 "$MQ_URL/healthz" >/dev/null; then
  printf '  %s✓ gitea-mq answers%s\n' "$GREEN" "$RESET"
else
  warn "no answer. Check the deployment's logs in Coolify and DNS for $MQ_DOMAIN. With both fine, the proxy may"
  warn "not reach the container: see the README's Check step. Then re-run."
  exit 1
fi
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$MQ_URL/" || true)
if [[ "$code" == 418 ]]; then
  printf '  %s✓ the dashboard is hidden (418)%s\n' "$GREEN" "$RESET"
else
  warn "$MQ_URL/ answered $code, not 418: the dashboard may be public. Redeploy from a commit"
  warn "whose docker-compose.yml has two sankaku-mq-private routers for $MQ_DOMAIN."
  pause
fi

stage "Delete the downloaded key"
say "Coolify holds the key now; GitHub can generate a new one any time."
if [[ -z "$PEM_PATH" ]]; then
  note "No key was downloaded this run."
elif confirm "Delete $PEM_PATH?"; then
  rm -P "$PEM_PATH" 2>/dev/null || rm -f "$PEM_PATH"
  printf '  %s✓ deleted%s\n' "$GREEN" "$RESET"
else
  SKIPPED+=("delete $PEM_PATH")
fi

stage "Install the App on the repo"
say "Once installed, gitea-mq queues every PR labelled merge-queue. Its temporary branches are built only by the"
say "build.yml that has the gitea-mq/** trigger, so main must have it first: otherwise each queued PR waits an hour,"
say "then loses its label."
gh label create merge-queue --repo "$REPO" --color 0E8A16 \
  --description "Queued: gitea-mq tests it on main and merges it (merge-queue/README.md)" 2>/dev/null || true
if ! on_main .github/workflows/merge-queue.yml; then
  warn "main doesn't have merge-queue.yml yet. Re-run once #402 has merged; the stages so far can be skipped."
  exit 1
fi
open_url "https://github.com/settings/apps/$APP_SLUG/installations"
step "Click 'Install' next to your account."
step "Choose 'Only select repositories' → sankaku-app → Install. No other repository."
pause "Done?"
# gh's login can't list installations (GitHub allows that only with a token issued to a GitHub App), so this is a look
# at the installation's page.
open_url "https://github.com/settings/installations"
step "Next to $APP_SLUG, click 'Configure'. Under 'Repository access', 'Only select repositories' is chosen and"
note "  sankaku-app is the only repository listed."
if ! confirm "Is it installed on sankaku-app only?"; then
  warn "choose 'Only select repositories' there, keep only sankaku-app, and Save. Then re-run."
  exit 1
fi
open_url "https://github.com/settings/apps/$APP_SLUG/advanced"
step "Under 'Recent Deliveries', the installation's deliveries have a green tick."
pause "Fine?"

stage "Require the queue on main"
say "Creates the ruleset 'gitea-mq': main requires the gitea-mq check, posted by App $APP_ID only."
say "The repo admin role (you) can bypass it, as with the main ruleset. The main ruleset isn't changed."
say "From then on, every PR merges through the queue. To switch it off, delete this ruleset (see the README)."
existing=$(gh api "repos/$REPO/rulesets" --jq '.[] | select(.name == "gitea-mq") | .id' || true)
if [[ -n "$existing" ]]; then
  printf '  %s✓ the gitea-mq ruleset already exists (id %s)%s\n' "$GREEN" "$existing" "$RESET"
elif confirm "Create the ruleset on $REPO?"; then
  gh api --method POST "repos/$REPO/rulesets" --input - >/dev/null <<JSON
{
  "name": "gitea-mq",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}],
  "rules": [{
    "type": "required_status_checks",
    "parameters": {
      "strict_required_status_checks_policy": false,
      "do_not_enforce_on_create": true,
      "required_status_checks": [{"context": "gitea-mq", "integration_id": $APP_ID}]
    }
  }]
}
JSON
  printf '  %s✓ created the gitea-mq ruleset%s\n' "$GREEN" "$RESET"
else
  SKIPPED+=("create the gitea-mq ruleset (re-run; the earlier stages can be skipped quickly)")
fi

finish
}

run_wizard "$@"; exit
