# Copy to .env.local or .env (both git-ignored) and fill in a dedicated test account.
SANKAKU_LOGIN=
SANKAKU_PASSWORD=
# Set to false to skip the favourite/unfavourite step.
SANKAKU_TRY_FAVOURITE=true
# An expired access token (the Phase 0 one from 2026-10-29), replayed by discovery step 3 after 2026-11-05.
SANKAKU_EXPIRED_ACCESS_TOKEN=
# Where steps 16 and 17 keep cursors and Following's top between runs (default ~/.sankaku-cli/feed-ledger.json).
# SANKAKU_FEED_LEDGER=
